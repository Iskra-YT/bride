{
  "name": "bride-cli",
  "version": "1.2.1",
  "description": "Bride is the runtime bridge between WebAssembly and the Web.",
  "language": "c",
  "type": "module",
  "main": "./runtime/bride.js",
  "bin": {
    "bride": "./bin/bride.js"
  },
  "files": [
    "bin",
    "runtime",
    "template",
    "lib",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "smoke": "node tests/smoke/smoke.mjs",
    "bench": "node benchmarks/run.mjs"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "wasm-runtime",
    "webassembly-browser",
    "browser-runtime",
    "dom",
    "web",
    "frontend",
    "ui",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iskra-YT/bride.git"
  },
  "author": "Szymon Izdebski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Iskra-YT/bride/issues"
  },
  "homepage": "https://github.com/Iskra-YT/bride#readme",
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
